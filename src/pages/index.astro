---
import { db, listPosts, type Post } from "../lib/db";
import { isAuthenticated } from "../lib/auth";

export const prerender = false;

const env = (Astro.locals as any).runtime?.env;
const authed = await isAuthenticated(Astro.request, env);

let posts: Post[] = [];
let dbError: string | null = null;
try {
  posts = await listPosts(db(Astro.locals));
} catch (e: any) {
  dbError = e?.message || "Could not load posts.";
}

// "2026-07-30T19:25" -> "2026-07-30 19:25" (no timezone surprises)
const fmtDate = (iso: string) => iso.replace("T", " ").slice(0, 16);
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Odes & Codes</title>
    <style is:global>
        :root {
            --bg: #e8e4d9;
            --card-bg: #f4f1e6;
            --grid-line: rgba(82, 101, 85, 0.12);
            --accent: #4a5d4e;
            --text: #2c2c2c;
            --border: rgba(0, 0, 0, 0.1);
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: "Courier", "Courier New", monospace;
            margin: 0;
            padding: 60px 20px;
        }

        /* Paper Grain Overlay */
        body::after {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            filter: url(#noise);
            z-index: 9999;
            opacity: 0.4;
        }

        /* FRONT AND CENTER TITLE */
        header {
            width: 100%;
            text-align: center;
            margin-bottom: 80px;
        }

        header h1 {
            font-size: 1.5rem;
            letter-spacing: 15px;
            color: var(--accent);
            text-transform: uppercase;
            margin: 0 auto;
            display: inline-block;
            border-bottom: 2px solid var(--accent);
            padding-bottom: 15px;
        }

        .layout-grid {
            max-width: 1000px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 40px;
        }

        @media (max-width: 850px) {
            .layout-grid { grid-template-columns: 1fr; }
            header h1 { font-size: 1.1rem; letter-spacing: 8px; }
        }

/* 1. Default state (Mobile first): Not sticky */
        .sidebar {
            position: relative;
            top: auto;
            height: auto;
        }

        /* 2. Desktop state: Sticky only on large screens */
        @media (min-width: 851px) {
            .layout-grid {
                display: grid;
                grid-template-columns: 300px 1fr;
                gap: 40px;
            }
            .sidebar {
                position: sticky;
                top: 40px;
                height: fit-content;
            }
        }

        /* 3. Mobile adjustments */
        @media (max-width: 850px) {
            .layout-grid {
                display: block; /* Stack vertically */
            }
            header {
                margin-bottom: 30px;
            }
            header h1 {
                font-size: 1.1rem;
                letter-spacing: 6px;
            }
            .sidebar {
                margin-bottom: 40px; /* Space between About and the first card */
            }
        }
        .card {
            background-color: var(--card-bg);
            background-image:
                linear-gradient(var(--grid-line) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
            background-size: 20px 20px;
            border: 1px solid var(--border);
            padding: 30px;
            margin-bottom: 30px;
            position: relative;
            box-shadow: 2px 2px 0px rgba(0,0,0,0.05);
        }

        .card::after {
            content: "";
            position: absolute;
            top: 0; left: 35px; width: 1px; height: 100%;
            background-color: rgba(180, 0, 0, 0.1);
        }

        h2 { font-size: 0.9rem; text-decoration: underline; margin-top: 0; margin-bottom: 15px; }

        .post-body { font-size: 1rem; line-height: 1.5; white-space: pre-wrap; margin-bottom: 20px; z-index: 10; position: relative; }
        .caption { font-size: 0.75rem; font-weight: bold; border-top: 1px dashed var(--border); padding-top: 10px; color: var(--accent); }

        footer {
            grid-column: 1 / -1;
            text-align: center;
            font-size: 0.75rem;
            color: #7d7d7d;
            margin-top: 80px;
            padding: 40px;
            border-top: 1px solid var(--border);
        }

        /* ---- Editor UI (rendered only when logged in) ---- */
        .composer-toggle {
            width: 100%;
            background: var(--accent);
            color: #f4f1e6;
            border: none;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: bold;
            padding: 14px;
            cursor: pointer;
            margin-bottom: 30px;
            letter-spacing: 2px;
        }
        .composer-toggle:hover { opacity: 0.9; }
        .post-form label {
            display: block;
            font-size: 0.75rem;
            font-weight: bold;
            margin: 12px 0 4px;
            color: var(--accent);
            position: relative;
            z-index: 10;
        }
        .post-form input,
        .post-form textarea {
            width: 100%;
            box-sizing: border-box;
            font-family: inherit;
            font-size: 0.95rem;
            padding: 10px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.6);
            color: var(--text);
            position: relative;
            z-index: 10;
        }
        .post-form textarea { min-height: 160px; line-height: 1.5; resize: vertical; }
        .post-form .row { display: flex; gap: 10px; margin-top: 14px; }
        .btn {
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: bold;
            padding: 10px 18px;
            border: none;
            cursor: pointer;
            background: var(--accent);
            color: #f4f1e6;
        }
        .btn:hover { opacity: 0.9; }
        .btn.ghost {
            background: transparent;
            color: var(--text);
            border: 1px solid var(--border);
        }
        .btn.danger { background: #a33b3b; }
        .card-actions {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 20;
            display: flex;
            gap: 8px;
        }
        .card-actions button {
            font-family: inherit;
            font-size: 0.7rem;
            font-weight: bold;
            padding: 4px 10px;
            cursor: pointer;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--accent);
        }
        .card-actions button:hover { background: var(--accent); color: #f4f1e6; }
        .card-actions button.del:hover { background: #a33b3b; border-color: #a33b3b; }
        /* Keep long titles from sliding under the absolute-positioned buttons */
        .card-actions + .post-view h2 { padding-right: 130px; }
        .edit-form { display: none; }
        .form-status { font-size: 0.8rem; margin-top: 10px; min-height: 1.2em; }
        .logout-link {
            display: inline-block;
            margin-top: 12px;
            font-size: 0.75rem;
            color: var(--accent);
            background: none;
            border: none;
            font-family: inherit;
            cursor: pointer;
            text-decoration: underline;
            padding: 0;
        }
    </style>
</head>
<body>
    <header>
        <h1>ODES & CODES</h1>
    </header>

    <div class="layout-grid">
        <aside class="sidebar">
            <div class="card">
                <h2>ABOUT PROJECT</h2>
                <div class="post-body">
                    A digital ledger of technical experiments and poetic fragments.
                    Built on Astro, served on Cloudflare.
                </div>
                {authed && (
                    <form method="POST" action="/api/auth/logout">
                        <button type="submit" class="logout-link">log out</button>
                    </form>
                )}
            </div>
        </aside>

        <main class="stream">
            {authed && (
                <div>
                    <button class="composer-toggle" id="composer-toggle" type="button">+ NEW ENTRY</button>
                    <div class="card" id="composer" style="display:none">
                        <h2>NEW ENTRY</h2>
                        <div class="post-form">
                            <label for="c-title">TITLE</label>
                            <input id="c-title" type="text" placeholder="title" />
                            <label for="c-desc">CAPTION</label>
                            <input id="c-desc" type="text" placeholder="short caption under the post" />
                            <label for="c-date">DATE</label>
                            <input id="c-date" type="datetime-local" />
                            <label for="c-body">ENTRY</label>
                            <textarea id="c-body" placeholder="write it here..."></textarea>
                            <div class="row">
                                <button class="btn" type="button" id="publish-btn">PUBLISH</button>
                                <button class="btn ghost" type="button" id="composer-cancel">CANCEL</button>
                            </div>
                            <div class="form-status" id="composer-status"></div>
                        </div>
                    </div>
                </div>
            )}

            {dbError && (
                <div class="card">
                    <h2>DATABASE NOT CONNECTED</h2>
                    <div class="post-body">{dbError}</div>
                </div>
            )}

            {posts.map(post => (
                <article class="card" id={`post-${post.id}`}>
                    {authed && (
                        <div class="card-actions">
                            <button type="button" data-edit={post.id}>edit</button>
                            <button type="button" class="del" data-delete={post.id}>delete</button>
                        </div>
                    )}
                    <div class="post-view">
                        {post.title && <h2>{post.title}</h2>}
                        <div class="post-body">{post.body}</div>
                        <div class="caption">// {fmtDate(post.post_date)}{post.description ? ` — ${post.description}` : ""}</div>
                    </div>
                    {authed && (
                        <div class="post-form edit-form" id={`edit-${post.id}`}>
                            <label>TITLE</label>
                            <input type="text" id={`e-title-${post.id}`} value={post.title} />
                            <label>CAPTION</label>
                            <input type="text" id={`e-desc-${post.id}`} value={post.description} />
                            <label>DATE</label>
                            <input type="datetime-local" id={`e-date-${post.id}`} value={post.post_date.slice(0, 16)} />
                            <label>ENTRY</label>
                            <textarea id={`e-body-${post.id}`}>{post.body}</textarea>
                            <div class="row">
                                <button class="btn" type="button" data-save={post.id}>SAVE</button>
                                <button class="btn ghost" type="button" data-cancel={post.id}>CANCEL</button>
                            </div>
                            <div class="form-status" id={`e-status-${post.id}`}></div>
                        </div>
                    )}
                </article>
            ))}

            {!dbError && posts.length === 0 && (
                <div class="card">
                    <div class="post-body">Nothing here yet.</div>
                </div>
            )}
        </main>

        <footer>
            <p>© 2026 Odes and Codes. ALL RIGHTS RESERVED.</p>
        </footer>
    </div>

    <svg style="display: none;">
      <filter id="noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer><feFuncA type="linear" slope="0.05" /></feComponentTransfer>
      </filter>
    </svg>

    {authed && (
    <script>
        const $ = (id) => document.getElementById(id);

        function nowLocal() {
            const d = new Date();
            const p = (n) => String(n).padStart(2, "0");
            return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
        }

        // Composer
        $("composer-toggle").addEventListener("click", () => {
            const c = $("composer");
            const open = c.style.display === "none";
            c.style.display = open ? "block" : "none";
            if (open && !$("c-date").value) $("c-date").value = nowLocal();
            if (open) $("c-body").focus();
        });
        $("composer-cancel").addEventListener("click", () => {
            $("composer").style.display = "none";
        });

        async function api(path, method, payload) {
            const res = await fetch(path, {
                method,
                headers: { "Content-Type": "application/json" },
                body: payload ? JSON.stringify(payload) : undefined,
            });
            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                throw new Error(err.error || `Request failed (${res.status})`);
            }
            return res.json().catch(() => ({}));
        }

        $("publish-btn").addEventListener("click", async () => {
            const btn = $("publish-btn");
            const status = $("composer-status");
            const payload = {
                title: $("c-title").value.trim(),
                description: $("c-desc").value.trim(),
                body: $("c-body").value,
                post_date: $("c-date").value || nowLocal(),
            };
            if (!payload.body.trim()) { status.textContent = "The entry is empty."; return; }
            btn.disabled = true;
            status.textContent = "Publishing...";
            try {
                await api("/api/posts", "POST", payload);
                location.reload();
            } catch (e) {
                status.textContent = "Error: " + e.message;
                btn.disabled = false;
            }
        });

        // Per-post edit / save / cancel / delete
        document.querySelectorAll("[data-edit]").forEach((b) =>
            b.addEventListener("click", () => {
                const id = b.getAttribute("data-edit");
                $(`post-${id}`).querySelector(".post-view").style.display = "none";
                $(`edit-${id}`).style.display = "block";
            })
        );
        document.querySelectorAll("[data-cancel]").forEach((b) =>
            b.addEventListener("click", () => {
                const id = b.getAttribute("data-cancel");
                $(`edit-${id}`).style.display = "none";
                $(`post-${id}`).querySelector(".post-view").style.display = "block";
            })
        );
        document.querySelectorAll("[data-save]").forEach((b) =>
            b.addEventListener("click", async () => {
                const id = b.getAttribute("data-save");
                const status = $(`e-status-${id}`);
                const payload = {
                    title: $(`e-title-${id}`).value.trim(),
                    description: $(`e-desc-${id}`).value.trim(),
                    body: $(`e-body-${id}`).value,
                    post_date: $(`e-date-${id}`).value || nowLocal(),
                };
                b.disabled = true;
                status.textContent = "Saving...";
                try {
                    await api(`/api/posts/${id}`, "PATCH", payload);
                    location.reload();
                } catch (e) {
                    status.textContent = "Error: " + e.message;
                    b.disabled = false;
                }
            })
        );
        document.querySelectorAll("[data-delete]").forEach((b) =>
            b.addEventListener("click", async () => {
                const id = b.getAttribute("data-delete");
                if (!confirm("Delete this entry? This cannot be undone.")) return;
                try {
                    await api(`/api/posts/${id}`, "DELETE");
                    location.reload();
                } catch (e) {
                    alert("Delete failed: " + e.message);
                }
            })
        );
    </script>
    )}
</body>
</html>
